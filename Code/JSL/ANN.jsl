/// ANN Neural Network in JMP + Python
dt = Current Data Table();
script_path = Get Default Directory();
Python Send( dt );
Python Send( script_path );

Python Submit( "
import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.metrics import r2_score, mean_squared_error
from sklearn.preprocessing import StandardScaler
from sklearn.inspection import permutation_importance
import matplotlib.pyplot as plt
import os
import jmp

from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense
from tensorflow.keras.callbacks import EarlyStopping

# -----------------------------
# Parameters
# -----------------------------
target_column = 'Strength2'
test_size = 0.3
random_state = 42
epochs = 300
batch_size = 64

# -----------------------------
# Load data from JMP
# -----------------------------
ncols = dt.ncols
col_names = [jmp.DataTable.Column(dt, i).name for i in range(ncols)]
data = {name: jmp.DataTable.Column(dt, name)[:] for name in col_names}
df = pd.DataFrame(data)

# Clean column names
df.columns = df.columns.astype(str).str.strip()

# -----------------------------
# Train-test split
# -----------------------------
X = df.drop(columns=[target_column])
y = df[target_column]

X_train, X_val, y_train, y_val = train_test_split(X, y, test_size=test_size, random_state=random_state)

# -----------------------------
# Scale features and target
# -----------------------------
scaler_X = StandardScaler()
X_train_scaled = scaler_X.fit_transform(X_train)
X_val_scaled = scaler_X.transform(X_val)

scaler_y = StandardScaler()
y_train_scaled = scaler_y.fit_transform(y_train.values.reshape(-1,1))
y_val_scaled = scaler_y.transform(y_val.values.reshape(-1,1))

# -----------------------------
# Build Advanced ANN Model
# -----------------------------
model_ann = Sequential([
    Dense(512, activation='relu', input_shape=(X_train_scaled.shape[1],)),
    Dense(256, activation='relu'),
    Dense(128, activation='relu'),
    Dense(64, activation='relu'),
    Dense(1, activation='linear')
])

# Compile model
model_ann.compile(optimizer='adam', loss='mse')

# Early stopping to avoid overfitting
early_stop = EarlyStopping(monitor='loss', patience=15, restore_best_weights=True)

# Train Model
model_ann.fit(X_train_scaled, y_train_scaled, epochs=300, batch_size=64, verbose=1, callbacks=[early_stop])

# -----------------------------
# Predictions
# -----------------------------
y_train_pred_scaled = model.predict(X_train_scaled)
y_val_pred_scaled = model.predict(X_val_scaled)

y_train_pred = scaler_y.inverse_transform(y_train_pred_scaled)
y_val_pred = scaler_y.inverse_transform(y_val_pred_scaled)

# -----------------------------
# Permutation Importance
# -----------------------------
class KerasModelWrapper:
    def __init__(self, model, scaler_y):
        self.model = model
        self.scaler_y = scaler_y
    def predict(self, X):
        return self.scaler_y.inverse_transform(self.model.predict(X)).flatten()
    def fit(self, X, y):
        pass

wrapped_model = KerasModelWrapper(model, scaler_y)
perm = permutation_importance(
    wrapped_model,
    X_val_scaled,
    y_val.values,
    n_repeats=10,
    random_state=random_state,
    scoring='neg_root_mean_squared_error'
)

perm_df = pd.DataFrame({'Feature': X.columns, 'Importance': perm.importances_mean})
perm_df = perm_df.sort_values(by='Importance', ascending=False).head(25)

plt.figure(figsize=(8, 6))
plt.barh(perm_df['Feature'], perm_df['Importance'], color='black')
plt.title('Top 25 Permutation Importances (ANN)', fontsize=12, weight='bold')
plt.xlabel('Mean Importance')
plt.ylabel('Feature')
plt.gca().invert_yaxis()
plt.tight_layout()
perm_image_path = os.path.join(script_path, 'ANN_permutation_importance.png')
plt.savefig(perm_image_path, dpi=100, bbox_inches='tight')
plt.close()

# -----------------------------
# Plot: Training vs Validation Loss Curve
# -----------------------------
history = model_ann.fit(
    X_train_scaled, y_train_scaled,
    validation_data=(X_val_scaled, y_val_scaled),
    epochs=epochs,
    batch_size=batch_size,
    verbose=1,
    callbacks=[early_stop]
)

plt.figure(figsize=(8, 6))
plt.plot(history.history['loss'], label='Training Loss', color='black')
plt.plot(history.history['val_loss'], label='Validation Loss', color='gray')
plt.title('Loss Curve (Training vs Validation)', fontsize=14, weight='bold')
plt.xlabel('Epoch')
plt.ylabel('Loss (MSE)')
plt.legend()
plt.tight_layout()

loss_image_path = os.path.join(script_path, 'ANN_loss_curve.png')
plt.savefig(loss_image_path, dpi=100, bbox_inches='tight')
plt.close()

# -----------------------------
# Create results DataFrame
# -----------------------------
results = pd.DataFrame(index=df.index)
results['ANN_Predicted'] = np.nan
results['ANN_Actual'] = np.nan
results['ANN_Residual'] = np.nan
results['ANN_Split'] = 'Unassigned'

# Training results
results.loc[X_train.index, 'ANN_Predicted'] = y_train_pred.flatten()
results.loc[X_train.index, 'ANN_Actual'] = y_train.values
results.loc[X_train.index, 'ANN_Residual'] = y_train.values - y_train_pred.flatten()
results.loc[X_train.index, 'ANN_Split'] = 'Training'

# Validation results
results.loc[X_val.index, 'ANN_Predicted'] = y_val_pred.flatten()
results.loc[X_val.index, 'ANN_Actual'] = y_val.values
results.loc[X_val.index, 'ANN_Residual'] = y_val.values - y_val_pred.flatten()
results.loc[X_val.index, 'ANN_Split'] = 'Validation'

results = results.fillna(0)

# -----------------------------
# Convert to JMP lists
# -----------------------------
pred_list = results['ANN_Predicted'].tolist()
actual_list = results['ANN_Actual'].tolist()
residual_list = results['ANN_Residual'].tolist()
set_list = results['ANN_Split'].tolist()

# -----------------------------
# Print model performance
# -----------------------------
print('Training R²:', r2_score(y_train, y_train_pred))
print('Training RMSE:', np.sqrt(mean_squared_error(y_train, y_train_pred)))
print('Validation R²:', r2_score(y_val, y_val_pred))
print('Validation RMSE:', np.sqrt(mean_squared_error(y_val, y_val_pred)))
" );

/// --- Create NEW table in JMP ---
newTable = New Table( "ANN_Results",
    Add Rows( N Rows( dt ) ),
    New Column( "ANN_Predicted", Numeric, Continuous, Set Values( Python Get( pred_list ) ) ),
    New Column( "ANN_Actual", Numeric, Continuous, Set Values( Python Get( actual_list ) ) ),
    New Column( "ANN_Residual", Numeric, Continuous, Set Values( Python Get( residual_list ) ) ),
    New Column( "ANN_Split", Character, Set Values( Python Get( set_list ) ) )
);

/// --- Open Permutation Importance Plot ---
Open( script_path || "/" || "ANN_permutation_importance.png" );
Open( script_path || "/" || "ANN_loss_curve.png" );
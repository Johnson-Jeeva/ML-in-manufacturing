// Step 1: JMP data table to Python
dt = Current Data Table();
Python Send( dt );

// Step 2: Python script 
Python Submit( "
import pandas as pd
import numpy as np
from sklearn.ensemble import RandomForestRegressor
from sklearn.model_selection import train_test_split
from sklearn.metrics import r2_score, mean_squared_error
import jmp

# ----- Parameters -----
target_column = 'Strength2'      
test_size = 0.3                   
random_state = 42                 
n_estimators = 100                


# Load JMP table into pandas DataFrame
ncols = dt.ncols
col_names = [jmp.DataTable.Column(dt, i).name for i in range(ncols)]
data = {name: jmp.DataTable.Column(dt, name)[:] for name in col_names}
df = pd.DataFrame(data)

# Feature/target separation
X = df.drop(columns=[target_column])
y = df[target_column]

# Split data
X_train, X_val, y_train, y_val = train_test_split(X, y, test_size=test_size, random_state=random_state)

# Train model
model = RandomForestRegressor(n_estimators=n_estimators, random_state=random_state)
model.fit(X_train, y_train)

# Predict
y_train_pred = model.predict(X_train)
y_val_pred = model.predict(X_val)

# Create prediction vectors for JMP
preds = pd.Series(index=df.index, dtype='float64')
actuals = pd.Series(index=df.index, dtype='float64')
sets = pd.Series(index=df.index, dtype='object')

preds[X_train.index] = y_train_pred
preds[X_val.index] = y_val_pred
actuals[X_train.index] = y_train
actuals[X_val.index] = y_val
sets[X_train.index] = 'Training'
sets[X_val.index] = 'Validation'

# Convert to JMP-friendly lists
pred_list = preds.tolist()
actual_list = actuals.tolist()
set_list = sets.tolist()

# Metrics
# Metrics in simple print format
train_r2 = r2_score(y_train, y_train_pred)
val_r2 = r2_score(y_val, y_val_pred)
train_rmse = np.sqrt(mean_squared_error(y_train, y_train_pred))
val_rmse = np.sqrt(mean_squared_error(y_val, y_val_pred))
train_n = len(y_train)
val_n = len(y_val)

print('Training R²:', train_r2)
print('Training RMSE:', train_rmse)
print('N:', train_n)
print('Validation R²:', val_r2)
print('Validation RMSE:', val_rmse)
print('N:', val_n)
" );

// Step 3: Send predictions and set info back to JMP
dt << New Column("RF_Predicted", Numeric, Continuous, Set Values( Python Get( pred_list ) ));
dt << New Column("RF_Actual", Numeric, Continuous, Set Values( Python Get( actual_list ) ));
dt << New Column("RF_Split", Character, Set Values( Python Get( set_list ) ));